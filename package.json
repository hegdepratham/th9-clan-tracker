{
  "name": "th9-clan-tracker",
  "version": "1.0.0",
  "description": "Personal TH9 Clan Tracker for Clash of Clans",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "init-db": "npm --prefix server run init-db",
    "hash-password": "node scripts/hashPassword.js",
    "test": "node test/smokeTest.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.4.0",
    "@neon/env": "^1.3.0"
  }
}
